# === Obligatorias ===
GROQ_API_KEY=tu_api_key_de_groq
APP_API_KEY=clave_secreta_compartida_con_el_widget

# === Opcionales ===
# Orígenes permitidos para el widget (CORS). Separados por coma.
# En producción: la URL del sitio del cliente, ej. https://casabrasa.com
ALLOWED_ORIGINS=*
# Modelo de Groq (configurable sin tocar código)
GROQ_MODEL=openai/gpt-oss-120b
# Puerto (Render lo define solo)
PORT=3000
# SOLO PARA DESARROLLO LOCAL: responde sin llamar a Groq.
# Nunca activar en producción.
MOCK_AI=false
